
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GraphicsLabAvalonia.Views.SettingsWindow"
        Title="Настройки" Width="350" Height="230"
        Background="#2d2d2d">
    
    <StackPanel Margin="15" Spacing="10">
        <TextBlock Text="Обработка данных" FontSize="16" 
                   Foreground="White" FontWeight="Bold"/>
        
        <TextBlock Text="Выберите преобразование:"
                   Foreground="#cccccc" TextWrapping="Wrap"/>
        
        <ListBox x:Name="ProcessorListBox" Height="100"
                 Background="#4d4d4d" Foreground="White" />
        
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" Spacing="10">
            <Button Content="ОК" Background="#007acc" Foreground="White"
                    Click="OnOkClick" Width="70"/>
            <Button Content="Отмена" Background="#555" Foreground="White"
                    Click="OnCancelClick" Width="70"/>
        </StackPanel>
    </StackPanel>
</Window>